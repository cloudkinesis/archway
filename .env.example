ARCHWAY_ENV=development
ARCHWAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ARCHWAY_DATA_DIR=.archway
ARCHWAY_OLLAMA_URL=http://localhost:11434
ARCHWAY_OLLAMA_MODEL=llama3.2:latest
# Optional explicit external compiler override (debug fallback only). Leave unset:
# the default runtime imports the vendored packages/archway_diagram_compiler/src.
# ARCHWAY_DIAGRAM_COMPILER_PATH=
ARCHWAY_ENABLE_WEB_SEARCH=false
ARCHWAY_ENABLE_COMPETITOR_WEB_SEARCH=false
ARCHWAY_TAVILY_MAX_CALLS_PER_SESSION=0
ARCHWAY_TAVILY_API_KEY=
ARCHWAY_TAVILY_MCP_URL=
ARCHWAY_TAVILY_API_URL=https://api.tavily.com/search
ARCHWAY_ENABLE_AWS_DOCS_MCP=true
ARCHWAY_AWS_DOCS_MCP_URL=https://aws-mcp.us-east-1.api.aws/mcp
ARCHWAY_AWS_DOCS_MCP_AUTH_TOKEN=
ARCHWAY_ENABLE_AWS_PRICING_REFERENCE_MCP=true
ARCHWAY_AWS_PRICING_REFERENCE_MCP_URL=https://aws-mcp.us-east-1.api.aws/mcp
ARCHWAY_AWS_PRICING_REFERENCE_MCP_AUTH_TOKEN=
ARCHWAY_ENABLE_AWS_PRICING_MCP=false
ARCHWAY_AWS_PRICING_MCP_URL=
ARCHWAY_AWS_PRICING_MCP_AUTH_TOKEN=
ARCHWAY_AWS_PRICING_MCP_COMMAND=uvx
ARCHWAY_AWS_PRICING_MCP_ARGS=awslabs.aws-pricing-mcp-server@latest
ARCHWAY_AWS_PRICING_MCP_AWS_PROFILE=default
ARCHWAY_AWS_PRICING_MCP_AWS_REGION=us-east-1
ARCHWAY_ENABLE_AWS_OFFICIAL_WEB_FALLBACK=true
ARCHWAY_AWS_PRICE_LIST_BULK_INDEX_URL=https://pricing.us-east-1.amazonaws.com/offers/v1.0/aws/index.json
ARCHWAY_LLM_PROVIDER=deterministic
ARCHWAY_BEDROCK_REGION=us-east-1
ARCHWAY_BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
ARCHWAY_BEDROCK_USE_INFERENCE_PROFILE=true
ARCHWAY_BEDROCK_MAX_TOKENS=8192
ARCHWAY_BEDROCK_TIMEOUT_SECONDS=120
ARCHWAY_BEDROCK_RETRY_COUNT=2
ARCHWAY_BEDROCK_TEMPERATURE_DEFAULT=0.2
ARCHWAY_BEDROCK_ENABLE_STRUCTURED_OUTPUT=true
